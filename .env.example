# ── AI Providers ──────────────────────────────────────────
# At least one is required for AI-powered analysis
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Market Data (Angel One SmartAPI) ──────────────────────
# Optional — falls back to yfinance if not configured
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# ── News ──────────────────────────────────────────────────
NEWSAPI_KEY=

# ── Auth & Database ──────────────────────────────────────
SECRET_KEY=change-this-to-a-random-string
DATABASE_URL=sqlite:///./stocksense.db
