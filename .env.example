# ── AI ───────────────────────────────────────────────────
# Required for every AI analysis feature (Claude).
ANTHROPIC_API_KEY=sk-ant-...
# Optional: news sentiment. Without it every headline is reported Neutral.
GROQ_API_KEY=

# ── Market Data (Angel One SmartAPI) ──────────────────────
# Optional — falls back to yfinance if not configured. Leave all four blank
# unless you have a SmartAPI app; the app then skips the broker login entirely.
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
# Your Angel One login PIN (MPIN).
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# ── Auth & Database ──────────────────────────────────────
# REQUIRED. The app refuses to start without it, and rejects placeholders and
# anything under 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=sqlite:///./stocksense.db
