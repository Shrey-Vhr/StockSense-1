# Normalise line endings so the repo doesn't churn between Windows and macOS/Linux
# checkouts. Without this, git reports 73 files as modified purely because of
# CRLF vs LF.
* text=auto eol=lf

# Windows-only entry points must keep CRLF or cmd.exe mangles them.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.mp4 binary
*.db binary
*.sqlite binary
*.sqlite3 binary
